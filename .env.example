SSH_PORT=
SSH_KEY=~/.ssh/id_rsa

# OpenTopography — request a key at https://portal.opentopography.org/
# (Account → myOpenTopo → request API key).
OPENTOPO_USER=your_username
OPENTOPO_API_KEY=your_api_key

# DEM dataset (demtype) from the OpenTopography global DEM API.
# Region options (all ~30 m): COP30, SRTMGL1, AW3D30, NASADEM.
# USGS10m (10 m) is CONUS-only — not available for Central Asia.
OPENTOPO_DEMTYPE=COP30
